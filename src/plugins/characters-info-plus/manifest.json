{
  "id": "characters-info-plus",
  "name": "Characters info+",
  "version": "1.0.1",
  "manifestURI": "https://raw.githubusercontent.com/Seanime-contributions/Seanime-Providers/main/src/plugins/characters-info-plus/manifest.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Show AniList character information in an animated hover card on anime entry pages.",
  "author": "Pal",
  "icon": "https://raw.githubusercontent.com/Seanime-contributions/Seanime-Providers/main/public/char-plus-info.png",
  "website": "",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/Seanime-contributions/Seanime-Providers/main/src/plugins/characters-info-plus/main.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [],
      "allow": {
        "unsafeFlags": [
          {
            "flag": "dom-script-manipulation",
            "reason": "Required to inject the character hover cards and suppress native character-link navigation."
          }
        ],
        "networkAccess": {
          "allowedDomains": ["graphql.anilist.co"],
          "reasoning": "Required to fetch character details from AniList."
        }
      }
    }
  },
  "isDevelopment": false
}
