{
  "id": "anilist-activity",
  "name": "Anilist activity",
  "version": "1.3.15",
  "manifestURI": "https://raw.githubusercontent.com/Pal-droid/Seanime-Providers/refs/heads/main/src/plugins/anilist-activities/manifest.json",
  "description": "A plugin for viewing your friend's and your Anilist activities inside Seanime.",
  "author": "Pal",
  "icon": "https://raw.githubusercontent.com/Pal-droid/Seanime-Providers/refs/heads/main/public/anilist.ico",
  "language": "typescript",
  "type": "plugin",
  "payloadURI": "https://raw.githubusercontent.com/Pal-droid/Seanime-Providers/main/src/plugins/anilist-activities/main.ts",
  "lang": "multi",
  "userConfig": {
    "requiresConfig": false,
    "version": 2,
    "fields": [
      {
        "name": "injectionPoint",
        "label": "Injection Point",
        "type": "select",
        "default": "toolbar",
        "options": [
          {
            "label": "Default (Toolbar)",
            "value": "toolbar"
          },
          {
            "label": "Above Currently Watching",
            "value": "above-watching"
          },
          {
            "label": "Bottom of Page",
            "value": "bottom-page"
          }
        ]
      },
      {
        "name": "manualOverrideSelector",
        "label": "Manual Selector Override (CSS)",
        "type": "text",
        "default": ""
      },
      {
        "name": "activityHistoryDays",
        "label": "Activity History",
        "type": "select",
        "default": "7",
        "options": [
          {
            "label": "1 day",
            "value": "1"
          },
          {
            "label": "3 days",
            "value": "3"
          },
          {
            "label": "7 days (Default)",
            "value": "7"
          },
          {
            "label": "14 days",
            "value": "14"
          },
          {
            "label": "30 days",
            "value": "30"
          },
          {
            "label": "90 days",
            "value": "90"
          }
        ]
      },
      {
        "name": "cacheRefreshMinutes",
        "label": "Cache Refresh Interval",
        "type": "select",
        "default": "5",
        "options": [
          {
            "label": "1 minute",
            "value": "1"
          },
          {
            "label": "5 minutes (Default)",
            "value": "5"
          },
          {
            "label": "15 minutes",
            "value": "15"
          },
          {
            "label": "30 minutes",
            "value": "30"
          },
          {
            "label": "60 minutes",
            "value": "60"
          }
        ]
      },
      {
        "name": "bgStyle",
        "label": "Background Style",
        "type": "select",
        "default": "glass",
        "options": [
          {
            "label": "Glass (Blur)",
            "value": "glass"
          },
          {
            "label": "Solid Dark",
            "value": "dark"
          },
          {
            "label": "Solid Light",
            "value": "light"
          },
          {
            "label": "Transparent",
            "value": "transparent"
          }
        ]
      },
      {
        "name": "ringColor",
        "label": "Ring Color",
        "type": "select",
        "default": "#FF6F61",
        "options": [
          {
            "label": "Coral (Default)",
            "value": "#FF6F61"
          },
          {
            "label": "AniList Blue",
            "value": "#3DB4F2"
          },
          {
            "label": "Emerald Green",
            "value": "#10B981"
          },
          {
            "label": "Violet",
            "value": "#8B5CF6"
          },
          {
            "label": "Hot Pink",
            "value": "#EC4899"
          },
          {
            "label": "Orange",
            "value": "#F97316"
          },
          {
            "label": "Red",
            "value": "#EF4444"
          },
          {
            "label": "White",
            "value": "#FFFFFF"
          },
          {
            "label": "Seanime accent",
            "value": "seanime"
          }
        ]
      },
      {
        "name": "replyPosition",
        "label": "Reply Modal Position",
        "type": "select",
        "default": "right",
        "options": [
          {
            "label": "Right Side (Default)",
            "value": "right"
          },
          {
            "label": "Left Side",
            "value": "left"
          }
        ]
      }
    ]
  },
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "anilist-token",
        "database",
        "storage"
      ],
      "allow": {
        "networkAccess": {
          "allowedDomains": [
            "graphql.anilist.co"
          ],
          "reasoning": "Required to fetch AniList activities in the plugin runtime before rendering the UI."
        },
        "unsafeFlags": [
          {
            "flag": "dom-script-manipulation",
            "reason": "Allows script injection to render Anilist activity."
          }
        ]
      }
    }
  }
}
